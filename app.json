{
  "expo": {
    "name": "SugamPath",
    "slug": "sugampath",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F0EB",
    "splash": {
      "backgroundColor": "#F1F0EB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sugampath.app"
    },
    "android": {
      "package": "com.sugampath.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1F0EB"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
